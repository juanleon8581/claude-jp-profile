        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "supabase-agent-skills": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    },
    "ui-ux-pro-max-skill": {
