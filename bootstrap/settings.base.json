{
  "permissions": {
    "allow": [
      "Bash(pnpm vitest:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:coverage)",
      "Bash(ls:*)",
      "Bash(git:*)",
      "mcp__taiga",
      "mcp__shadcn"
    ],
    "ask": [
      "mcp__taiga__delete_epic",
      "mcp__taiga__delete_issue",
      "mcp__taiga__delete_milestone",
      "mcp__taiga__delete_role",
      "mcp__taiga__delete_task",
      "mcp__taiga__delete_userstory",
      "mcp__taiga__delete_webhook",
      "mcp__taiga__delete_wiki_page"
    ],
    "defaultMode": "auto"
  },
  "language": "español",
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "mp@mp-marketplace": true,
    "caveman@caveman": true,
    "skill-creator@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "supabase@supabase-agent-skills": true,
    "postgres-best-practices@supabase-agent-skills": true,
    "terminal-browser@terminal-browser": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "impeccable@impeccable": true,
    "taste-skill@taste-skill": true
  },
  "extraKnownMarketplaces": {
    "mp-marketplace": {
      "source": {
        "source": "github",
        "repo": "juanleon8581/claude-jp-profile"
      }
    },
    "caveman": {
